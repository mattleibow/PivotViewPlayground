  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pivot.Core\Pivot.Core.csproj" />
  </ItemGroup>

</Project>
